# ============================================
# Unity 项目专用 .gitignore
# 只提交源资产与设置，所有可再生成的目录一律排除
# ============================================

# Unity 生成目录（体积巨大且可完全重新生成）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 打包输出
*.apk
*.aab
*.unitypackage
*.app

# IDE / 编辑器
/.vs/
/.idea/
/.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Unity 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 调试截图（本地排错用，不进仓库）
/Assets/DebugScreenShot/
/Assets/DebugScreenShot.meta

# API 密钥（绝对不进仓库！仓库是公开的）
/GeminiAiApiKey.txt
/*ApiKey*.txt
/*.apikey

# AI 对话调试日志（开发用，不进仓库）。试聊台的日志在 AiTalkLogs/Editor/ 子目录
/AiTalkLogs/

# AI 试聊台的记忆预设（本地调试场景，不进仓库）
/AiTalkStudio/
