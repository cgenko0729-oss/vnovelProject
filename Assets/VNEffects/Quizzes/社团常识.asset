%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0bc70e660518ce4692357254d30bcec, type: 3}
  m_Name: "\u793E\u56E2\u5E38\u8BC6"
  m_EditorClassIdentifier: Assembly-CSharp::VNEffects.VNQuizDef
  quizId: "\u793E\u56E2\u5E38\u8BC6"
  title: "\u793E\u56E2\u5E38\u8BC6\u5C0F\u6D4B\u9A8C"
  titleEn: Club Trivia Quiz
  titleJa: "\u90E8\u6D3B\u5E38\u8B58\u30AF\u30A4\u30BA"
  defaultTimeLimit: 15
  flagPrefix: "\u7B54\u9898"
  questions:
  - text: "\u6587\u5316\u796D\u5728\u6BCF\u5E74\u7684\u51E0\u6708\u4E3E\u529E\uFF1F"
    textEn: Which month is the school festival held?
    textJa: "\u6587\u5316\u796D\u306F\u6BCE\u5E74\u4F55\u6708\u306B\u884C\u308F\u308C\u308B\uFF1F"
    options:
    - text: "9 \u6708"
      textEn: September
      textJa: "9\u6708"
    - text: "10 \u6708"
      textEn: October
      textJa: "10\u6708"
    - text: "11 \u6708"
      textEn: November
      textJa: "11\u6708"
    answerIndex: 1
    explain: "\u6587\u5316\u796D\u56FA\u5B9A\u5728 10 \u6708\u7684\u7B2C\u4E8C\u4E2A\u5468\u672B\u3002"
    explainEn: The festival is always the second weekend of October.
    explainJa: "\u6587\u5316\u796D\u306F\u6BCE\u5E7410\u6708\u306E\u7B2C2\u9031\u672B\u306B\u958B\u50AC\u3055\u308C\u308B\u3002"
    timeLimit: 0
    rewardOnCorrect:
    - statId: "\u667A\u529B"
      amount: 3
    penaltyOnWrong:
    - statId: "\u538B\u529B"
      amount: 4
  - text: "\u793E\u56E2\u6D3B\u52A8\u5BA4\u5728\u54EA\u4E00\u680B\u697C\uFF1F"
    textEn: Which building is the clubroom in?
    textJa: "\u90E8\u5BA4\u306F\u3069\u306E\u68DF\u306B\u3042\u308B\uFF1F"
    options:
    - text: "\u65E7\u6821\u820D"
      textEn: Old Building
      textJa: "\u65E7\u6821\u820E"
    - text: "\u65B0\u6821\u820D"
      textEn: New Building
      textJa: "\u65B0\u6821\u820E"
    - text: "\u4F53\u80B2\u9986"
      textEn: Gymnasium
      textJa: "\u4F53\u80B2\u9928"
    answerIndex: 0
    explain: "\u65E7\u6821\u820D\u4E09\u697C\u6700\u91CC\u9762\u90A3\u95F4\u5C31\u662F\u793E\u56E2\u6D3B\u52A8\u5BA4\u3002"
    explainEn: Third floor of the old building, at the very end of the hall.
    explainJa: "\u65E7\u6821\u820E3\u968E\u3001\u5ECA\u4E0B\u306E\u4E00\u756A\u5965\u304C\u90E8\u5BA4\u3002"
    timeLimit: 0
    rewardOnCorrect:
    - statId: "\u667A\u529B"
      amount: 3
    penaltyOnWrong:
    - statId: "\u538B\u529B"
      amount: 4
  - text: "\u793E\u56E2\u6210\u7ACB\u65F6\u6700\u5C11\u9700\u8981\u51E0\u540D\u6210\u5458\uFF1F"
    textEn: How many members are needed to found a club?
    textJa: "\u90E8\u3092\u8A2D\u7ACB\u3059\u308B\u306B\u306F\u6700\u4F4E\u4F55\u4EBA\u5FC5\u8981\uFF1F"
    options:
    - text: "3 \u4EBA"
      textEn: 3
      textJa: "3\u4EBA"
    - text: "5 \u4EBA"
      textEn: 5
      textJa: "5\u4EBA"
    - text: "7 \u4EBA"
      textEn: 7
      textJa: "7\u4EBA"
    answerIndex: 1
    explain: "\u6821\u89C4\u89C4\u5B9A\u6EE1 5 \u4EBA\u624D\u80FD\u6B63\u5F0F\u767B\u8BB0\u6210\u793E\u56E2\u3002"
    explainEn: School rules require five members for official registration.
    explainJa: "\u6821\u5247\u3067\u306F5\u4EBA\u63C3\u3063\u3066\u521D\u3081\u3066\u6B63\u5F0F\u306A\u90E8\u3068\u3057\u3066\u767B\u9332\u3067\u304D\u308B\u3002"
    timeLimit: 0
    rewardOnCorrect:
    - statId: "\u667A\u529B"
      amount: 3
    penaltyOnWrong:
    - statId: "\u538B\u529B"
      amount: 4
  - text: "\u793E\u56E2\u9884\u7B97\u7533\u8BF7\u7684\u622A\u6B62\u65E5\u662F\uFF1F"
    textEn: When is the club budget request due?
    textJa: "\u90E8\u8CBB\u7533\u8ACB\u306E\u7DE0\u5207\u306F\uFF1F"
    options:
    - text: "\u5B66\u671F\u7B2C\u4E00\u5468"
      textEn: First week of term
      textJa: "\u5B66\u671F\u306E\u7B2C1\u9031"
    - text: "\u5B66\u671F\u7B2C\u4E09\u5468"
      textEn: Third week of term
      textJa: "\u5B66\u671F\u306E\u7B2C3\u9031"
    - text: "\u5B66\u671F\u6700\u540E\u4E00\u5468"
      textEn: Last week of term
      textJa: "\u5B66\u671F\u306E\u6700\u7D42\u9031"
    answerIndex: 0
    explain: "\u9519\u8FC7\u7B2C\u4E00\u5468\u5C31\u53EA\u80FD\u7B49\u4E0B\u5B66\u671F\u4E86\u3002"
    explainEn: Miss the first week and you wait a whole term.
    explainJa: "\u7B2C1\u9031\u3092\u9003\u3059\u3068\u6765\u5B66\u671F\u307E\u3067\u5F85\u3064\u3053\u3068\u306B\u306A\u308B\u3002"
    timeLimit: 0
    rewardOnCorrect:
    - statId: "\u667A\u529B"
      amount: 3
    penaltyOnWrong:
    - statId: "\u538B\u529B"
      amount: 4
  - text: "\u793E\u56E2\u987E\u95EE\u8001\u5E08\u6559\u7684\u662F\u54EA\u4E00\u79D1\uFF1F"
    textEn: What subject does the club advisor teach?
    textJa: "\u9867\u554F\u306E\u5148\u751F\u306E\u62C5\u5F53\u79D1\u76EE\u306F\uFF1F"
    options:
    - text: "\u56FD\u8BED"
      textEn: Literature
      textJa: "\u56FD\u8A9E"
    - text: "\u7269\u7406"
      textEn: Physics
      textJa: "\u7269\u7406"
    - text: "\u7F8E\u672F"
      textEn: Art
      textJa: "\u7F8E\u8853"
    answerIndex: 2
    explain: "\u987E\u95EE\u662F\u7F8E\u672F\u79D1\u7684\u8001\u5E08\uFF0C\u6240\u4EE5\u793E\u56E2\u6D77\u62A5\u603B\u662F\u7279\u522B\u8BB2\u7A76\u3002"
    explainEn: "The advisor teaches art \u2014 that's why the club posters look so
      good."
    explainJa: "\u9867\u554F\u306F\u7F8E\u8853\u306E\u5148\u751F\u3002\u3060\u304B\u3089\u90E8\u306E\u30DD\u30B9\u30BF\u30FC\u306F\u3044\u3064\u3082\u51DD\u3063\u3066\u3044\u308B\u3002"
    timeLimit: 0
    rewardOnCorrect:
    - statId: "\u667A\u529B"
      amount: 3
    penaltyOnWrong:
    - statId: "\u538B\u529B"
      amount: 4
